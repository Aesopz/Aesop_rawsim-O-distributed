<?xml version="1.0" encoding="utf-8"?>
<SettingConfiguration xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!-- citi-lab setting: mirrors netlogo-rmfs 8-hour simulation (28800 ticks x 0.15 s/tick) -->
  <Name>citi-lab</Name>
  <SimulationWarmupTime>0</SimulationWarmupTime>
  <SimulationDuration>28800</SimulationDuration>
  <Seed>0</Seed>
  <LogLevel>Info</LogLevel>
  <DebugMode>RealTime</DebugMode>
  <Tolerance>0.2</Tolerance>
  <UseAcceleration>false</UseAcceleration>
  <UseTurnDelay>false</UseTurnDelay>
  <RotatePods>false</RotatePods>
  <QueueHandlingEnabled>true</QueueHandlingEnabled>
  <StationShutdownThresholdTime>600</StationShutdownThresholdTime>
  <InventoryConfiguration>
    <ItemType>SimpleItem</ItemType>
    <OrderMode>Fill</OrderMode>
    <InitialInventory>0.7</InitialInventory>
    <IgnoreCapacityForBundleGeneration>false</IgnoreCapacityForBundleGeneration>
    <BufferBundlesUntilInventoryLoad>1.1</BufferBundlesUntilInventoryLoad>
    <WarmupOrderCount>5000</WarmupOrderCount>
    <ItemWeightMin>5</ItemWeightMin>
    <ItemWeightMax>5</ItemWeightMax>
    <BundleSizeMin>6</BundleSizeMin>
    <BundleSizeMax>6</BundleSizeMax>
    <PositionCountMean>1</PositionCountMean>
    <PositionCountStdDev>0.3</PositionCountStdDev>
    <PositionCountMin>1</PositionCountMin>
    <PositionCountMax>3</PositionCountMax>
    <!-- netlogo-rmfs: 1-12 items/order, avg ~6 -->
    <OrderPositionCountMean>6</OrderPositionCountMean>
    <OrderPositionCountStdDev>2</OrderPositionCountStdDev>
    <OrderPositionCountMin>1</OrderPositionCountMin>
    <OrderPositionCountMax>12</OrderPositionCountMax>
    <DemandInventoryConfiguration>
      <!-- netlogo-rmfs: ~100 orders/hour across 3 stations = ~33/station; demand pool -->
      <OrderCount>100</OrderCount>
      <BundleCount>100</BundleCount>
    </DemandInventoryConfiguration>
    <SimpleItemConfiguration>
      <GeneratorConfigFile>ItemGen-100-100-10000.xgenc</GeneratorConfigFile>
    </SimpleItemConfiguration>
  </InventoryConfiguration>
</SettingConfiguration>
